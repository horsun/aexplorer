function ex_validdir($dir) {
  $path = realpath($dir);
  return in_array(explode('/',$path)[1]??'',['mnt','boot']) ? $path : '';
}
$docroot = $docroot ?: $_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp';
$dir = ex_validdir(htmlspecialchars_decode(rawurldecode($_GET['dir']??'/mnt')));
if (!$dir) $dir = '/mnt';
$dir = htmlspecialchars(str_replace('\\','\\\\',$dir));
// CSRF token（系统 Control.php 上传/操作需要）
$csrf = $var['csrf_token'] ?? ($_SESSION['csrf_token'] ?? '');
?>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="csrf-token" content="<?= htmlspecialchars($csrf); ?>">
<?php
// 用户列表（owner 下拉数据源：/etc/passwd UID>=1000 + root + nobody，只读）
$ae_users = ['nobody', 'root'];
$ae_pw = @file('/etc/passwd');
if ($ae_pw) {
  foreach ($ae_pw as $ae_l) {
    $ae_f = explode(':', trim($ae_l));
    if (count($ae_f) >= 3 && (int)$ae_f[2] >= 1000 && !in_array($ae_f[0], $ae_users)) $ae_users[] = $ae_f[0];
  }
}
?>
<script>window.AE_USERS = <?= json_encode($ae_users, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG); ?>;</script>
